# ──────────────────────────────────────────────────────────────
# .env.example — Template environment variables for FlowStock-Web
# Copy to `.env` for local dev. For production, set in Vercel.
#
# Naming convention:
#   - VITE_*  → exposed to the browser (client-side, React)
#   - others  → server-only (Express routes, Vercel functions)
# ──────────────────────────────────────────────────────────────

# ── Builder.io ────────────────────────────────────────────────
VITE_PUBLIC_BUILDER_KEY=__BUILDER_PUBLIC_KEY__

# ── App config ────────────────────────────────────────────────
PING_MESSAGE="ping pong"

# ── Supabase (Database) ───────────────────────────────────────
# Get from Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── AI Services (HuggingFace Spaces) ──────────────────────────
# AI-1 (sync-inventory)        → server-side (no VITE_ prefix)
# AI-2 (recommendation engine) → client-side
# AI-3 (action alerts)         → client-side
FLOWSTOCK_AI_1_BASE_URL=https://fhatikaadr-flowstock-ai-1.hf.space
VITE_FLOWSTOCK_AI_2_BASE_URL=https://fhatikaadr-flowstock-ai-2.hf.space
VITE_FLOWSTOCK_AI_3_BASE_URL=https://fhatikaadr-flowstock-ai-3.hf.space
